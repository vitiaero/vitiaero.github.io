{
  "name": "vitidrone",
  "version": "1.0.0",
  "private": true,
  "description": "Service d'epandage viticole par drone en Suisse romande - vitrine + application",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n API,WEB -c green,cyan \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node server/index.js --port=3001",
    "dev:client": "vite",
    "build": "vite build",
    "serve": "npm run build && node server/index.js",
    "start": "node server/index.js",
    "preview": "vite preview",
    "images": "node scripts/download-images.js"
  },
  "dependencies": {
    "@turf/turf": "^7.2.0",
    "express": "^4.22.3",
    "leaflet": "^1.9.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.3",
    "sql.js": "^1.12.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "vite": "^7.3.6"
  },
  "engines": {
    "node": ">=20.19"
  }
}
